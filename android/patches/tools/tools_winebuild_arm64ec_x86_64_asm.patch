winebuild: Use x86_64 assembly for arm64ec targets.

Backport of upstream wine ae2433e6. The arm64ec spec object becomes x64 code,
so lld places it in an x64 code range; the -import thunks in
tools_winebuild_spec32_c_import_thunks.patch depend on it. The winegcc hunk
is adapted because upstream f0fde619 (pass the target CPU to build_tool_name)
is not in this tree.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60463

diff --git a/tools/winebuild/build.h b/tools/winebuild/build.h
index 3acf987aab2..3cb5659e1ea 100644
--- a/tools/winebuild/build.h
+++ b/tools/winebuild/build.h
@@ -274,7 +274,6 @@ extern int sort_func_list( ORDDEF **list, int count, int (*compare)(const void *
 extern unsigned int get_section_alignment(void);
 extern unsigned int get_args_size( const ORDDEF *odp );
 extern const char *asm_name( const char *func );
-extern const char *arm64_name( const char *func );
 extern const char *asm_globl( const char *func );
 extern const char *get_asm_ptr_keyword(void);
 extern const char *get_asm_string_keyword(void);
diff --git a/tools/winebuild/import.c b/tools/winebuild/import.c
index 2d7caa0883e..e66e056cf86 100644
--- a/tools/winebuild/import.c
+++ b/tools/winebuild/import.c
@@ -1087,6 +1087,7 @@ void output_stubs( DLLSPEC *spec )
             output_cfi( ".cfi_endproc" );
             break;
         case CPU_x86_64:
+        case CPU_ARM64EC:
             output_cfi( ".cfi_startproc" );
             output_seh( ".seh_proc %s", asm_name(name) );
             output( "\tsubq $0x28,%%rsp\n" );
@@ -1117,8 +1118,7 @@ void output_stubs( DLLSPEC *spec )
             output( "\t.seh_endproc\n" );
             break;
         case CPU_ARM64:
-        case CPU_ARM64EC:
-            output( "\t.seh_proc %s\n", arm64_name(name) );
+            output( "\t.seh_proc %s\n", asm_name(name) );
             output( "\t.seh_endprologue\n" );
             output( "\tadrp x0, .L__wine_spec_file_name\n" );
             output( "\tadd x0, x0, #:lo12:.L__wine_spec_file_name\n" );
@@ -1129,7 +1129,7 @@ void output_stubs( DLLSPEC *spec )
             }
             else
                 output( "\tmov x1, %u\n", odp->ordinal );
-            output( "\tb %s\n", arm64_name("__wine_spec_unimplemented_stub") );
+            output( "\tb %s\n", asm_name("__wine_spec_unimplemented_stub") );
             output( "\t.seh_endproc\n" );
             break;
         }
