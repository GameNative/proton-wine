index 00000000000..3ae46fc92e3
--- /dev/null
+++ b/dlls/ntdll/unix/sync.h
@@ -0,0 +1,31 @@
+/*
+ * Internal interface between esync/fsync and the inproc refcount cache.
+ * Not part of the public esync/fsync API.
+ */
+
+#ifndef __INPROC_SYNC_H
+#define __INPROC_SYNC_H
+
+#include <windef.h>
+
+/*
+ * Opaque from esync.c's perspective — esync only needs to hold and
+ * release pointers, it never reads the fields directly.
+ */
+struct inproc_sync;
+
+/* Grab a reference to the cached object for this handle.
+ * Returns NULL if the handle is not in the cache or its refcount
+ * has already hit zero (fd was freed).
+ * Caller must call release_inproc_sync() when done. */
+struct inproc_sync *get_cached_inproc_sync( HANDLE handle );
+
+/* Release a reference grabbed by get_cached_inproc_sync().
+ * Closes the underlying fd when refcount hits zero. */
+void release_inproc_sync( struct inproc_sync *sync );
+
+/* Register an esync fd into the refcount cache.
+ * Called from esync get_object() after the fd is received from server. */
+void esync_register_inproc( HANDLE handle, int fd );
+
+#endif /* __INPROC_SYNC_H */
