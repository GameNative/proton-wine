+    if (hybrid_desktop && hybrid_desktop[0])
+    {
+        DWORD len = strlen( hybrid_desktop ) + 1;
+        if ((desktop = malloc( len * sizeof(WCHAR) )))
+            desktop[ntdll_umbstowcs( hybrid_desktop, len - 1, desktop, len - 1 )] = 0;
