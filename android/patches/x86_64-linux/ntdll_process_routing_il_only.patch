diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index 118c5bc..6f09f24 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -407,8 +407,9 @@ static BOOL is_unix_console_handle( HANDLE handle )
  *
  *   WINE_HYBRID_X64_EXES      ';'-separated exe names ("game.exe") or Windows directory prefixes
  *                             ("c:\games\foo\"), matched case-insensitively against the image path.
- *                             An AMD64 image (not ARM64EC) that matches runs in the x86-64 Wine;
- *                             i386 images always run in the host's Wine, under its WoW64.
+ *                             An AMD64 image (not ARM64EC) or an IL-only image that Windows runs
+ *                             as a 64-bit process that matches runs in the x86-64 Wine; other i386
+ *                             images always run in the host's Wine, under its WoW64.
  *   WINE_HYBRID_X64_LOADER    space-separated command that runs the x86-64 Wine loader
  *                             (e.g. "<ld.so> --library-path <lib> <emulator> <x86-64 wine>").
  *   WINE_HYBRID_X64_ENV       ';'-separated NAME=VALUE changes for that command ("NAME=" unsets).
@@ -417,7 +418,8 @@ static BOOL is_unix_console_handle( HANDLE handle )
  *   WINE_HYBRID_NATIVE_EXES   exe names or directories an x86-64 process hands to the host's Wine
  *                             even though it could run them itself (system processes).
  *
- * A child of an x86-64 process stays in the x86-64 Wine unless its image is i386, cannot run
+ * A child of an x86-64 process stays in the x86-64 Wine unless its image is i386 (other than an
+ * IL-only image that runs as a 64-bit process), cannot run
  * there (ARM64 or ARM64X) or is listed in WINE_HYBRID_NATIVE_EXES.
  */
 static BOOL hybrid_list_match( const char *list, const char *path )
@@ -440,6 +442,14 @@ static BOOL hybrid_list_match( const char *list, const char *path )
     return FALSE;
 }
 
+/* an IL-only image that Windows runs as a 64-bit process (AnyCPU, not 32-bit required or preferred) */
+static BOOL hybrid_is_il_64bit( const struct pe_image_info *pe_info )
+{
+    return pe_info->machine == IMAGE_FILE_MACHINE_I386 &&
+           (pe_info->image_flags & IMAGE_FLAGS_ComPlusNativeReady) &&
+           !(pe_info->image_flags & IMAGE_FLAGS_ComPlusPrefer32bit);
+}
+
 static const char *hybrid_loader_for( const RTL_USER_PROCESS_PARAMETERS *params, const struct pe_image_info *pe_info )
 {
     const char *x64_loader = getenv( "WINE_HYBRID_X64_LOADER" );
@@ -460,18 +470,19 @@ static const char *hybrid_loader_for( const RTL_USER_PROCESS_PARAMETERS *params,
 
 #ifdef __x86_64__
     if (native_loader &&
-        (pe_info->machine == IMAGE_FILE_MACHINE_I386 ||
+        ((pe_info->machine == IMAGE_FILE_MACHINE_I386 && !hybrid_is_il_64bit( pe_info )) ||
          (!(x64_exes && hybrid_list_match( x64_exes, path )) &&
           (pe_info->machine == IMAGE_FILE_MACHINE_ARM64 || pe_info->is_hybrid ||
            (native_exes && hybrid_list_match( native_exes, path ))))))
         ret = "WINE_HYBRID_NATIVE";
 #else
-    if (x64_loader && x64_exes && pe_info->machine == IMAGE_FILE_MACHINE_AMD64 && !pe_info->is_hybrid &&
+    if (x64_loader && x64_exes &&
+        ((pe_info->machine == IMAGE_FILE_MACHINE_AMD64 && !pe_info->is_hybrid) || hybrid_is_il_64bit( pe_info )) &&
         hybrid_list_match( x64_exes, path ))
         ret = "WINE_HYBRID_X64";
 #endif
-    TRACE( "%s machine %04x hybrid %u -> %s\n", debugstr_a(path), pe_info->machine, pe_info->is_hybrid,
-           ret ? ret : "this Wine" );
+    TRACE( "%s machine %04x hybrid %u flags %02x -> %s\n", debugstr_a(path), pe_info->machine, pe_info->is_hybrid,
+           pe_info->image_flags, ret ? ret : "this Wine" );
     free( path );
     return ret;
 }
