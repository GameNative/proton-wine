+/* The user name: the profile name Wine was started with (WINEUSERNAME, from the Unix user), else
+ * Proton's fixed "steamuser". In a hybrid prefix this matches the host Wine, whose profile the prefix holds. */
+static const WCHAR *user_name(void)
+{
+    static WCHAR name[UNLEN + 1];
+    DWORD len;
+
+    if (!name[0])
+    {
+        len = GetEnvironmentVariableW( L"WINEUSERNAME", name, ARRAY_SIZE(name) );
+        if (!len || len >= ARRAY_SIZE(name) || wcschr( name, '\\' ) || wcschr( name, '/' ))
+            lstrcpyW( name, L"steamuser" );
+    }
+    return name;
+}
+
