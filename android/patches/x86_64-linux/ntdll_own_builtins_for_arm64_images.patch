diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index 10f7299..9564a00 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -2073,6 +2073,10 @@ void init_startup_info(void)
         wine_server_set_reply( req, info, startup_info_size );
         status = wine_server_call( req );
         machine = reply->machine;
+#ifdef __x86_64__
+        /* the parent chose the machine of an ARM64/ARM64X builtin; this process loads its x86-64 builtin */
+        if (machine == IMAGE_FILE_MACHINE_ARM64) machine = 0;
+#endif
         info_size = reply->info_size;
         env_size = (wine_server_reply_size( reply ) - info_size) / sizeof(WCHAR);
     }
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
