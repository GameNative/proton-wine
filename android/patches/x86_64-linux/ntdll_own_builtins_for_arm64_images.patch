@@ -1774,6 +1774,18 @@ NTSTATUS load_builtin( const struct pe_image_info *image_info, UNICODE_STRING *n
     if (is_arm64ec() && image_info->is_hybrid && search_machine == IMAGE_FILE_MACHINE_AMD64)
         search_machine = current_machine;
 
+#ifdef __x86_64__
+    /* A prefix made by an ARM64 Wine holds ARM64/ARM64X builtins in system32. Their code cannot run in
+     * this process, so take the builtin of the same name from this installation instead. */
+    if ((image_info->wine_builtin || image_info->wine_fakedll) &&
+        (search_machine == IMAGE_FILE_MACHINE_ARM64 || image_info->is_hybrid))
+    {
+        TRACE( "%s is a builtin for %04x, using the %04x one\n", debugstr_us(nt_name), search_machine, current_machine );
+        search_machine = current_machine;
+        if (loadorder == LO_BUILTIN_NATIVE) loadorder = LO_BUILTIN;  /* the file we found cannot be used */
+    }
+#endif
