+#if defined(__x86_64__) && defined(__linux__)
+/***********************************************************************
+ *           init_native_area
+ *
+ * The seccomp filter that traps system calls made from Windows code tells native code apart by address
+ * (see install_bpf). When the host address space ends below 0x700000000000, native libraries are loaded
+ * below that limit too. Split the host address space instead: the upper half is left to the host, the
+ * lower half is reserved for Windows views, so that native code cannot be mapped there and Windows views
+ * are not placed above it. Nothing is changed if native code is already executable in the lower half.
+ */
+static void init_native_area(void)
+{
+    char *end = (char *)host_addr_space_limit + granularity_mask + 1;
+    char *start = (char *)((UINT_PTR)end / 2);
+    unsigned long map_start, map_end;
+    char line[512], perms[5];
+    FILE *f;
+
+    if ((UINT_PTR)end > 0x700000000000 || ((UINT_PTR)start & 0xffffffff)) return;
+    if (!(f = fopen( "/proc/self/maps", "r" ))) return;
+    while (fgets( line, sizeof(line), f ))
+    {
+        if (sscanf( line, "%lx-%lx %4s", &map_start, &map_end, perms ) != 3 || perms[2] != 'x') continue;
+        if (map_start >= (UINT_PTR)start) continue;
+        if (map_start >= 0x7d400000 && map_end <= 0x7d402000) continue;  /* the preloader, see install_bpf */
+        ERR( "native code at %lx-%lx, not splitting the address space at %p.\n", map_start, map_end, start );
+        fclose( f );
+        return;
+    }
+    fclose( f );
+    reserve_area( (void *)0x10000, start );
+    host_addr_space_limit = start;
+    native_area_start = start;
+    native_area_end = end;
+    TRACE( "native area %p-%p\n", start, end );
+}
+#endif
+
+/***********************************************************************
+ *           virtual_get_native_area
+ *
+ * Return the part of the host address space left to native code by init_native_area, if any.
+ */
+void virtual_get_native_area( void **start, void **end )
+{
+    *start = native_area_start;
+    *end = native_area_end;
+}
+
 /***********************************************************************
  *           virtual_init
  */
@@ -3959,6 +4010,10 @@ void virtual_init(void)
         unsetenv( "WINEPRELOADRESERVE" );
     }
 
+#if defined(__x86_64__) && defined(__linux__)
+    init_native_area();
+#endif
+
     /* try to find space in a reserved area for the views and pages protection table */
 #ifdef _WIN64
     /* views may be placed up to address_space_limit even when the host limit is lower (see map_view) */
@@ -5430,8 +5485,9 @@ void virtual_set_large_address_space(void)
         {
             address_space_start = (void *)0x10000;
 #ifndef __APPLE__  /* don't free the zerofill section on macOS */
+            /* not when the lower half is kept for Windows views (see init_native_area) */
             if ((main_image_info.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA) &&
-                (main_image_info.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE))
+                (main_image_info.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE) && !native_area_start)
                 free_reserved_memory( 0, (char *)0x7ffe0000 );
 #endif
         }
