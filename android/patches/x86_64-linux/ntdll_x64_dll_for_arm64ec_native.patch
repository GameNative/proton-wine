+#ifdef __x86_64__
+/***********************************************************************
+ *           load_hybrid_substitute
+ *
+ * A prefix shared with an ARM64 Wine can hold native ARM64/ARM64EC dlls (graphics and audio
+ * replacements installed for that Wine). This process cannot run them; WINE_HYBRID_X64_DLLDIR
+ * lists Unix directories (':'-separated) with x86-64 dlls of the same names to load instead.
+ */
+static NTSTATUS load_hybrid_substitute( UNICODE_STRING *nt_name, void **module, SIZE_T *size,
+                                        SECTION_IMAGE_INFORMATION *info, ULONG_PTR limit_low,
+                                        ULONG_PTR limit_high, USHORT machine, off_t offset )
+{
+    const char *dirs = getenv( "WINE_HYBRID_X64_DLLDIR" ), *end;
+    unsigned int i, len = nt_name->Length / sizeof(WCHAR), namepos = 0;
+    char name[64], *path;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE mapping;
+    NTSTATUS status;
+
+    if (!dirs || !*dirs) return STATUS_DLL_NOT_FOUND;
+    for (i = 0; i < len; i++) if (nt_name->Buffer[i] == '\\' || nt_name->Buffer[i] == '/') namepos = i + 1;
+    if (len - namepos >= sizeof(name)) return STATUS_DLL_NOT_FOUND;
+    for (i = namepos; i < len; i++)
+    {
+        WCHAR ch = nt_name->Buffer[i];
+        if (ch >= 0x80) return STATUS_DLL_NOT_FOUND;
+        name[i - namepos] = (ch >= 'A' && ch <= 'Z') ? ch + 32 : ch;
+    }
+    name[len - namepos] = 0;
+
+    InitializeObjectAttributes( &attr, nt_name, 0, 0, NULL );
+    for (; *dirs; dirs = *end ? end + 1 : end)
+    {
+        if (!(end = strchr( dirs, ':' ))) end = dirs + strlen( dirs );
+        if (end == dirs) continue;
+        if (!(path = malloc( end - dirs + strlen( name ) + 2 ))) return STATUS_NO_MEMORY;
+        sprintf( path, "%.*s/%s", (int)(end - dirs), dirs, name );
+        status = open_dll_file( path, &attr, &mapping );
+        if (!status)
+        {
+            status = virtual_map_substitute_module( mapping, module, size, info, limit_low, limit_high,
+                                                    machine, offset );
+            NtClose( mapping );
+        }
+        if (NT_SUCCESS(status)) TRACE_(loaddll)( "%s: using x86-64 %s\n", debugstr_us(nt_name), debugstr_a(path) );
+        free( path );
+        if (status != STATUS_DLL_NOT_FOUND) return status;
+    }
+    return STATUS_DLL_NOT_FOUND;
+}
+#endif
+
+
