+/***********************************************************************
+ *           virtual_map_substitute_module
+ *
+ * Map a native x86-64 dll that replaces an ARM64/ARM64EC one (see load_builtin).
+ */
+NTSTATUS virtual_map_substitute_module( HANDLE mapping, void **module, SIZE_T *size,
+                                        SECTION_IMAGE_INFORMATION *info, ULONG_PTR limit_low,
+                                        ULONG_PTR limit_high, WORD machine, off_t offset )
+{
+    mem_size_t full_size;
+    unsigned int sec_flags;
+    HANDLE shared_file;
+    struct pe_image_info *image_info = NULL;
+    NTSTATUS status;
+    UNICODE_STRING nt_name;
+    ANSI_STRING exp_name;
+
+    if ((status = get_mapping_info( mapping, SECTION_MAP_READ, &sec_flags, &full_size, &shared_file,
+                                    &image_info, &nt_name, &exp_name )))
+        return status;
+
+    if (!image_info) return STATUS_INVALID_PARAMETER;
+
+    *module = NULL;
+    *size = 0;
+
+    if (image_info->machine != IMAGE_FILE_MACHINE_AMD64 || image_info->is_hybrid)
+    {
+        WARN_(module)( "%s is not an x86-64 dll, ignoring\n", debugstr_us(&nt_name) );
+        status = STATUS_DLL_NOT_FOUND;
+    }
+    else
+    {
+        status = virtual_map_image( mapping, module, size, shared_file, limit_low, limit_high, 0,
+                                    machine, image_info, &nt_name, image_info->wine_builtin, offset );
+        virtual_fill_image_information( image_info, info );
+    }
+
+    if (shared_file) NtClose( shared_file );
+    free( image_info );
+    return status;
+}
+
