diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index d4cc3b466d2..2c4dcdd86d3 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -1095,6 +1095,8 @@ struct device_manager_ctx
     /* for the virtual desktop settings */
     BOOL is_primary;
     DEVMODEW primary;
+    /* size of the virtual desktop source while its modes are being added */
+    DEVMODEW virtual_physical;
 };
 
 static void link_device( const char *instance, const char *class )
@@ -2355,6 +2357,16 @@ static void add_modes( const DEVMODEW *current, UINT host_modes_count, const DEV
     }
 
     physical = modes_count == 1 ? *modes : *current;
+
+    /* With a virtual desktop, mode changes are emulated: the desktop keeps its initial size,
+     * so it must stay the physical mode. Using the emulated current mode instead drops the
+     * desktop size from the mode list and games can no longer switch back to it. */
+    if (ctx->virtual_physical.dmSize)
+    {
+        physical = *current;
+        physical.dmPelsWidth = ctx->virtual_physical.dmPelsWidth;
+        physical.dmPelsHeight = ctx->virtual_physical.dmPelsHeight;
+    }
     if (ctx->is_primary) ctx->primary = *current;
 
     detached.dmPelsWidth = 0;
@@ -2978,7 +2990,9 @@ static BOOL add_virtual_source( struct device_manager_ctx *ctx )
 
     /* Expose the virtual source display modes as physical modes, to avoid DPI scaling */
     if (!(modes = get_virtual_modes( &initial, &maximum, NULL, 0, &modes_count ))) return STATUS_NO_MEMORY;
+    ctx->virtual_physical = initial;
     add_modes( &current, modes_count, modes, ctx );
+    ctx->virtual_physical.dmSize = 0;
     free( modes );
 
     return STATUS_SUCCESS;
