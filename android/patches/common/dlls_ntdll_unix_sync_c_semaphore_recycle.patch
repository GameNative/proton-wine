 }
 
+/* cache entry of a handle, without taking a reference */
+static struct inproc_sync *get_inproc_sync_slot( HANDLE handle )
+{
+    unsigned int entry, idx;
+
+    if (!handle || is_pseudo_handle( handle )) return NULL;
+    idx = inproc_sync_handle_to_index( handle, &entry );
+    if (entry >= INPROC_SYNC_CACHE_ENTRIES || !inproc_sync_cache[entry]) return NULL;
+    return &inproc_sync_cache[entry][idx];
+}
+
+/* a parked semaphore handle is still open on the server, but the application
+ * closed it; report it as invalid instead of asking the server.
+ * caller must hold fd_cache_mutex */
+static NTSTATUS check_parked_handle( HANDLE handle )
+{
+    struct inproc_sync *slot = get_inproc_sync_slot( handle );
+
+    if (slot && (slot->closed & INPROC_SYNC_PARKED)) return STATUS_INVALID_HANDLE;
+    return STATUS_SUCCESS;
+}
