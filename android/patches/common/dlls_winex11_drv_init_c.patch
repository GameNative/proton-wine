diff --git a/dlls/winex11.drv/init.c b/dlls/winex11.drv/init.c
index 479ff421a39..c42690e5fb3 100644
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -356,6 +356,26 @@ static void x11drv_client_surface_detach( struct client_surface *client )
     }
 }
 
+#ifdef __ANDROID__
+/* Android X servers (e.g. GameNative's) have no XComposite and show every window that has
+ * presented content as its own layer, even under an unmapped parent or fully off-screen
+ * (such layers end up unpositioned at the screen origin). So other process surfaces created
+ * under the dummy parent show up at the screen origin. Instead, keep them as mapped
+ * override-redirect windows exactly behind the target window, at the bottom of the stacking
+ * order, and let X11DRV_client_surface_present copy their contents into the target window,
+ * which covers them. */
+static void android_opwr_position( HWND hwnd, UINT dpi, int *x, int *y )
+{
+    RECT rect;
+
+    *x = *y = 0;
+    if (!NtUserGetClientRect( hwnd, &rect, dpi )) return;
+    NtUserMapWindowPoints( hwnd, 0, (POINT *)&rect, 2, dpi );
+    *x = rect.left;
+    *y = rect.top;
+}
+#endif
+
 static void client_surface_update_geometry( HWND hwnd, struct x11drv_client_surface *surface )
 {
     UINT dpi = surface->raw ? NtUserGetWinMonitorDpi( hwnd, MDT_WINE_RAW_DPI ) : NtUserGetDpiForWindow( hwnd );
@@ -378,6 +398,10 @@ static void client_surface_update_geometry( HWND hwnd, struct x11drv_client_surf
 
     changes.x = rect.left;
     changes.y = rect.top;
+#ifdef __ANDROID__
+    /* keep other process surfaces behind their target window, see android_opwr_position */
+    if (surface->other_process) android_opwr_position( hwnd, dpi, &changes.x, &changes.y );
+#endif
     changes.width  = min( max( 1, rect.right - rect.left ), 65535 );
     changes.height = min( max( 1, rect.bottom - rect.top ), 65535 );
     OffsetRect( &rect, -rect.left, -rect.top );
@@ -393,6 +417,9 @@ static void client_surface_update_geometry( HWND hwnd, struct x11drv_client_surf
     TRACE( "client window %p/%lx, requesting position %d,%d size %d,%d mask %#x\n", hwnd,
            surface->window, changes.x, changes.y, changes.width, changes.height, mask );
     XConfigureWindow( gdi_display, surface->window, mask, &changes );
+#ifdef __ANDROID__
+    if (surface->other_process) XLowerWindow( gdi_display, surface->window );
+#endif
     XFlush( gdi_display );
 }
 
@@ -528,6 +555,13 @@ static void X11DRV_client_surface_present( struct client_surface *client, HDC hd
         set_dc_drawable( surface->hdc_dst, window, &rect_dst, IncludeInferiors );
     if (region) NtGdiExtSelectClipRgn( surface->hdc_dst, region, RGN_COPY );
 
+#ifdef __ANDROID__
+    /* frame read back by win32u (other process surfaces), see win32u/vulkan.c readback_init */
+    if (client->readback_hdc)
+        NtGdiStretchBlt( surface->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
+                         client->readback_hdc, 0, 0, surface->rect.right, surface->rect.bottom, SRCCOPY, 0 );
+    else
+#endif
     NtGdiStretchBlt( surface->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
                      surface->hdc_src, 0, 0, surface->rect.right, surface->rect.bottom, SRCCOPY, 0 );
     XFlush( gdi_display );
@@ -600,15 +634,30 @@ Window x11drv_client_surface_create( HWND hwnd, BOOL raw, int format, struct cli
         attr.win_gravity = NorthWestGravity;
         attr.backing_store = NotUseful;
         attr.border_pixel = 0;
+#ifdef __ANDROID__
+        attr.override_redirect = True;
+        android_opwr_position( hwnd, dpi, &surface->changes.x, &surface->changes.y );
+        surface->changes.width = width;
+        surface->changes.height = height;
+        surface->window = XCreateWindow( gdi_display, root_window, surface->changes.x, surface->changes.y,
+                                         width, height, 0, default_visual.depth, InputOutput, default_visual.visual,
+                                         CWBitGravity | CWWinGravity | CWBackingStore | CWColormap | CWBorderPixel |
+                                         CWOverrideRedirect, &attr );
+#else
         surface->window = XCreateWindow( gdi_display, get_dummy_parent(), 0, 0, width, height, 0, default_visual.depth, InputOutput,
                                          default_visual.visual, CWBitGravity | CWWinGravity | CWBackingStore | CWColormap | CWBorderPixel, &attr );
+#endif
         if (surface->window)
         {
+#ifdef __ANDROID__
+            XLowerWindow( gdi_display, surface->window );
+#endif
             XMapWindow( gdi_display, surface->window );
             XSync( gdi_display, False );
             surface->other_process = TRUE;
         }
-        WARN( "Other process window %p / %#lx.\n", hwnd, surface->window );
+        WARN( "Other process window %p / %#lx at %d,%d %ux%u.\n", hwnd, surface->window,
+              surface->changes.x, surface->changes.y, width, height );
     }
 
     if (!surface->window && !(surface->window = create_client_window( hwnd, surface->rect, &visual, colormap ))) goto failed;
