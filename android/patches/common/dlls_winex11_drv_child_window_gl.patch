+/* Child windows (and windows with children) are composited offscreen: their client window is kept
+ * under the dummy parent and its contents are copied into the toplevel on present. That only works
+ * with XComposite redirecting the client window; without it (no libXcomposite at build time, or an
+ * X server without the extension) the X server keeps no contents for a window clipped by the 1x1
+ * dummy parent and the copy is black. In that case place the client window directly in the toplevel
+ * X window at the child's position instead (without clipping by siblings, as before the client
+ * surface rework), as long as nothing else requires offscreen rendering. */
+static Window get_child_client_parent( HWND hwnd )
+{
+    HWND toplevel = NtUserGetAncestor( hwnd, GA_ROOT );
+    struct x11drv_win_data *data;
+    Window parent = 0;
+
+    if (!toplevel || toplevel == hwnd || !NtUserIsWindowVisible( hwnd )) return 0;
+    if (needs_offscreen_rendering_self( toplevel )) return 0;
+    if ((data = get_win_data( toplevel )))
+    {
+        parent = data->whole_window;
+        release_win_data( data );
+    }
+    return parent;
+}
+
+static void place_child_client_window( struct x11drv_client_surface *surface, Window parent )
+{
+    if (surface->child_parent == parent) return;
+
+    TRACE( "%s placing client window %lx in %lx at %d,%d\n", debugstr_client_surface( &surface->client ),
+           surface->window, parent, surface->changes.x, surface->changes.y );
+
+    if (parent) XReparentWindow( gdi_display, surface->window, parent, surface->changes.x, surface->changes.y );
+    else XReparentWindow( gdi_display, surface->window, get_dummy_parent(), 0, 0 );
+    surface->child_parent = parent;
+    XFlush( gdi_display );
+}
+
 static void client_surface_update_offscreen( HWND hwnd, struct x11drv_client_surface *surface )
 {
     BOOL offscreen = needs_offscreen_rendering( hwnd );
     struct x11drv_win_data *data;
+    Window child_parent = 0;
 
     if (surface->other_process) offscreen = TRUE;
+    else if (offscreen && !usexcomposite && !needs_offscreen_rendering_self( hwnd ))
+    {
+        /* offscreen only for compositing, which needs XComposite, see get_child_client_parent */
+        if (NtUserGetAncestor( hwnd, GA_ROOT ) == hwnd) offscreen = FALSE;
+        else if ((child_parent = get_child_client_parent( hwnd ))) offscreen = FALSE;
+    }
 
     TRACE( "%s offscreen %u\n", debugstr_client_surface( &surface->client ), offscreen );
 
@@ -439,6 +490,7 @@
             attach_client_window( data, surface->window );
             release_win_data( data );
         }
+        place_child_client_window( surface, child_parent );
         return;
     }
 
@@ -476,6 +528,7 @@
         else attach_client_window( data, surface->window );
         release_win_data( data );
     }
+    place_child_client_window( surface, child_parent );
 
     XFlush( gdi_display );
 }
