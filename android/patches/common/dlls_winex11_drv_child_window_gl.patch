  *
  * Destroy the whole X window for a given window.
  */
+/* without XComposite, client windows of child windows are placed directly in their toplevel's
+ * whole_window (see get_child_client_parent in init.c); move them back to the dummy parent before
+ * whole_window is destroyed, or they would be destroyed with it */
+static void detach_child_client_windows( struct x11drv_win_data *data )
+{
+    Window root, parent, *children = NULL;
+    unsigned int i, count = 0;
+
+    if (usexcomposite) return;
+    XSync( data->display, False ); /* make sure whole_window is known from gdi_display */
+    if (!XQueryTree( gdi_display, data->whole_window, &root, &parent, &children, &count )) return;
+    for (i = 0; i < count; i++)
+    {
+        TRACE( "%p/%lx detaching child client window %lx\n", data->hwnd, data->whole_window, children[i] );
+        XReparentWindow( gdi_display, children[i], get_dummy_parent(), 0, 0 );
+    }
+    if (children) XFree( children );
+}
+
 static void destroy_whole_window( struct x11drv_win_data *data, BOOL already_destroyed )
 {
     TRACE( "win %p xwin %lx/%lx\n", data->hwnd, data->whole_window, data->client_window );
