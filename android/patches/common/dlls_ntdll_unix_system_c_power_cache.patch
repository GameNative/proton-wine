ntdll: Cache the ProcessorInformation power query for 500 ms.

NtPowerInformation(ProcessorInformation) opened and read two cpufreq files per
core on every call, about 228 us on an 8-core device, and some games (Age of
Empires IV) call it every frame. Cache the per-core array for 500 ms
(CLOCK_MONOTONIC) under a mutex.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60462

diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
index 1821c6eb3ca..199bae36888 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4851,46 +4851,73 @@ NTSTATUS WINAPI NtPowerInformation( POWER_INFORMATION_LEVEL level, void *input,
         if ((out_size / sizeof(PROCESSOR_POWER_INFORMATION)) < out_cpus) return STATUS_BUFFER_TOO_SMALL;
 #if defined(linux)
         {
+            static pthread_mutex_t power_info_mutex = PTHREAD_MUTEX_INITIALIZER;
+            static PROCESSOR_POWER_INFORMATION *cached_power;
+            static int cached_cpus;
+            static ULONGLONG cached_time;
             unsigned int val;
             char filename[128];
             FILE* f;
+            struct timespec ts;
+            ULONGLONG now;
 
-            for(i = 0; i < out_cpus; i++) {
-                snprintf(filename, sizeof(filename), "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", i);
