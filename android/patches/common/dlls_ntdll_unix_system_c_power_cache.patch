+                    memcpy( cached_power, cpu_power, out_cpus * sizeof(*cpu_power) );
+                    cached_time = now;
                 }
-
-                cpu_power[i].Number = i;
-                cpu_power[i].MaxIdleState = 0;     /* FIXME */
