+                        cpu_power[i].MaxMhz = cpu_power[i].CurrentMhz;
+                        if(f) fclose(f);
+                    }
+
+                    snprintf(filename, sizeof(filename), "/sys/devices/system/cpu/cpu%d/cpufreq/scaling_max_freq", i);
+                    f = fopen(filename, "r");
+                    if(f && (fscanf(f, "%u", &val) == 1)) {
+                        cpu_power[i].MhzLimit = val / 1000;
+                        fclose(f);
                     }
                     else
