diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index e12eb3bae7c..5282acaef9d 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3702,6 +3702,40 @@ static BOOL get_desired_wm_state( DWORD style, const struct window_rects *rects
 }
 
 
+#ifdef __ANDROID__
+/* When a fullscreen window is smaller than the screen (emulated display mode), its X window
+ * still covers the whole screen. Nothing paints the area around the window rect, and Android
+ * X servers show it as white instead of black. */
+static void fill_letterbox( struct x11drv_win_data *data )
+{
+    RECT window = data->rects.window, visible = data->rects.visible;
+    XRectangle bars[4];
+    int count = 0;
+    GC gc;
+
+    if (!data->whole_window || EqualRect( &window, &visible )) return;
+    if (window.left < visible.left || window.top < visible.top ||
+        window.right > visible.right || window.bottom > visible.bottom) return;
+
+    OffsetRect( &window, -visible.left, -visible.top );
+    OffsetRect( &visible, -visible.left, -visible.top );
+
+    if (window.top > 0) bars[count++] = (XRectangle){0, 0, visible.right, window.top};
+    if (window.bottom < visible.bottom)
+        bars[count++] = (XRectangle){0, window.bottom, visible.right, visible.bottom - window.bottom};
+    if (window.left > 0) bars[count++] = (XRectangle){0, window.top, window.left, window.bottom - window.top};
+    if (window.right < visible.right)
+        bars[count++] = (XRectangle){window.right, window.top, visible.right - window.right, window.bottom - window.top};
+    if (!count) return;
+
+    TRACE( "window %p/%lx filling %d letterbox bars\n", data->hwnd, data->whole_window, count );
+    gc = XCreateGC( data->display, data->whole_window, 0, NULL );
+    XSetForeground( data->display, gc, 0xff000000 );
+    XFillRectangles( data->display, data->whole_window, gc, bars, count );
+    XFreeGC( data->display, gc );
+}
+#endif
+
 /***********************************************************************
  *		WindowPosChanged   (X11DRV.@)
  */
@@ -3819,6 +3853,10 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
     /* if window was fullscreen and is being hidden, release cursor clipping */
     was_fullscreen &= data->desired_state.wm_state != NormalState;
 
+#ifdef __ANDROID__
+    fill_letterbox( data );
+#endif
+
     XFlush( data->display );  /* make sure changes are done before we start painting again */
     release_win_data( data );
 
