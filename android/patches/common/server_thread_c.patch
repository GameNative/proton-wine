diff --git a/server/thread.c b/server/thread.c
index 5c4a6bd0207..90b2940d387 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -63,6 +63,10 @@
 
 #include "fsync.h"
 
+#ifdef __ANDROID__
+#include "../android/ntsync_android/ntsync_user.h"
