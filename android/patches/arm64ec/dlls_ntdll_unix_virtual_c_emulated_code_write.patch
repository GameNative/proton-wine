diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -5000,6 +5000,66 @@
     mutex_unlock( &virtual_mutex );
     rec->ExceptionCode = ret;
     return ret;
+}
+
+
+/***********************************************************************
+ *           virtual_handle_emulated_code_write
+ *
+ * An ARM64EC emulator write-protects RWX pages it has translated code from, so that
+ * it notices self-modifying code. On Windows a system call writing its output into
+ * such a page succeeds; here the unix side faults and the call would return
+ * STATUS_ACCESS_VIOLATION. Make the page writable again for the call and tell the
+ * emulator that the page changed, as for a write from another process.
+ */
+BOOL virtual_handle_emulated_code_write( void *addr )
+{
+    char *page = ROUND_ADDR( addr, host_page_mask );
+    CHPEV2_PROCESS_INFO *info;
+    CROSS_PROCESS_WORK_LIST *list;
+    CROSS_PROCESS_WORK_ENTRY *entry;
+    CROSS_PROCESS_WORK_HDR prev, new;
+    struct file_view *view;
+    BOOL ret = FALSE;
+    BYTE vprot;
+
+    if (!is_arm64ec()) return FALSE;
+
+    mutex_lock( &virtual_mutex );  /* no need for signal masking inside signal handler */
+    if ((view = find_view( page, host_page_size )) && is_view_valloc( view ))
+    {
+        vprot = get_host_page_vprot( page );
+        if ((vprot & VPROT_COMMITTED) && (vprot & VPROT_EXEC) && (vprot & VPROT_READ) &&
+            !(vprot & (VPROT_WRITE | VPROT_WRITECOPY | VPROT_GUARD)))
+        {
+            set_page_vprot_bits( page, host_page_size, VPROT_WRITE, 0 );
+            ret = !mprotect_range( page, host_page_size, 0, 0 );
+        }
+    }
+    mutex_unlock( &virtual_mutex );
+    if (!ret) return FALSE;
+
+    TRACE( "syscall write to emulated code page %p\n", page );
+    if (!(info = peb->ChpeV2ProcessInfo) || !(list = (void *)info->CrossProcessWorkList)) return TRUE;
+    do
+    {
+        prev.hdr = list->free_list.hdr;
+        if (!prev.first) return TRUE;
+        entry = CROSS_PROCESS_LIST_ENTRY( &list->free_list, prev.first );
+        new.first = entry->next;
+        new.counter = prev.counter + 1;
+    } while (InterlockedCompareExchange64( &list->free_list.hdr, new.hdr, prev.hdr ) != prev.hdr);
+    entry->id = CrossProcessMemoryWrite;
+    entry->addr = (ULONG_PTR)page;
+    entry->size = host_page_size;
+    do
+    {
+        prev.hdr = list->work_list.hdr;
+        entry->next = prev.first;
+        new.first = ((char *)entry - (char *)&list->work_list) | (prev.first & CROSS_PROCESS_LIST_FLUSH);
+        new.counter = prev.counter + 1;
+    } while (InterlockedCompareExchange64( &list->work_list.hdr, new.hdr, prev.hdr ) != prev.hdr);
+    return TRUE;
 }
 
 
diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -1165,6 +1165,9 @@
     else rec.ExceptionInformation[0] = EXCEPTION_READ_FAULT;
     rec.ExceptionInformation[1] = (ULONG_PTR)siginfo->si_addr;
     if (!virtual_handle_fault( &rec, (void *)SP_sig(context) )) return;
+    if (rec.ExceptionCode == STATUS_ACCESS_VIOLATION && rec.ExceptionInformation[0] == EXCEPTION_WRITE_FAULT &&
+        is_inside_syscall( SP_sig(context) ) && virtual_handle_emulated_code_write( siginfo->si_addr ))
+        return;
     if (handle_syscall_fault( context, &rec )) return;
     setup_exception( context, &rec );
 }
