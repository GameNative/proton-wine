+/***********************************************************************
+ *           queue_emulated_code_write
+ *
+ * Tell the emulator that a system call wrote into a page it may have translated, the
+ * same way a write from another process is reported. The entry is applied the next
+ * time the emulator processes its cross-process work. When no entry is free, ask for
+ * a full flush instead, so the write is never lost.
+ */
+static void queue_emulated_code_write( void *addr, SIZE_T size )
+{
+    CHPEV2_PROCESS_INFO *info = peb->ChpeV2ProcessInfo;
+    CROSS_PROCESS_WORK_LIST *list;
+    CROSS_PROCESS_WORK_ENTRY *entry;
+    CROSS_PROCESS_WORK_HDR prev, new;
+
+    if (!info || !(list = (CROSS_PROCESS_WORK_LIST *)info->CrossProcessWorkList)) return;
+
+    do
+    {
+        prev.hdr = list->free_list.hdr;
+        if (!prev.first)
+        {
+            do
+            {
+                prev.hdr = list->work_list.hdr;
+                new.first = prev.first | CROSS_PROCESS_LIST_FLUSH;
+                new.counter = prev.counter + 1;
+            } while (InterlockedCompareExchange64( &list->work_list.hdr, new.hdr, prev.hdr ) != prev.hdr);
+            return;
+        }
+        entry = CROSS_PROCESS_LIST_ENTRY( &list->free_list, prev.first );
+        new.first = entry->next;
+        new.counter = prev.counter + 1;
+    } while (InterlockedCompareExchange64( &list->free_list.hdr, new.hdr, prev.hdr ) != prev.hdr);
+
+    entry->id = CrossProcessMemoryWrite;
+    entry->addr = (ULONG_PTR)addr;
+    entry->size = size;
+    do
+    {
+        prev.hdr = list->work_list.hdr;
+        entry->next = prev.first & ~CROSS_PROCESS_LIST_FLUSH;
+        new.first = ((char *)entry - (char *)&list->work_list) | (prev.first & CROSS_PROCESS_LIST_FLUSH);
+        new.counter = prev.counter + 1;
+    } while (InterlockedCompareExchange64( &list->work_list.hdr, new.hdr, prev.hdr ) != prev.hdr);
+}
+
+
