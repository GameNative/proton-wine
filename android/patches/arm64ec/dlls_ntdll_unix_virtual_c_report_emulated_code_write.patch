  * such a page succeeds; here the unix side faults and the call would return
- * STATUS_ACCESS_VIOLATION. Make the page writable again so the call completes.
+ * STATUS_ACCESS_VIOLATION. Make the page writable again so the call completes, and
+ * report the write so the emulator drops its translations of the page.
  */
 BOOL virtual_handle_emulated_code_write( void *addr )
 {
@@ -5032,6 +5081,7 @@ BOOL virtual_handle_emulated_code_write( void *addr )
         }
     }
     mutex_unlock( &virtual_mutex );
+    if (ret) queue_emulated_code_write( page, host_page_size );
     return ret;
 }
 
